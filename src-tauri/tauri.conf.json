{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rustock",
  "version": "0.7.0",
  "identifier": "com.rustock.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:6821",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rustock",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "shortDescription": "Gestión de inventario y almacén (mini-WMS) self-hosted",
    "longDescription": "Rustock es un sistema de gestión de inventario y almacén self-hosted: productos, ubicaciones, movimientos FIFO/FEFO, inventario físico con conteos, trazabilidad inmutable y control por roles.",
    "category": "Business",
    "copyright": "Copyright © 2026 Omar Sazar",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
