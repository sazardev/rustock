{
  "name": "rustock",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "design": "node scripts/design-guard.mjs",
    "routes": "node scripts/route-guard.mjs",
    "hooks": "lefthook install",
    "changelog": "git-cliff --output CHANGELOG.md",
    "changelog:unreleased": "git-cliff --output CHANGELOG.md --unreleased",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch --tag",
    "release:minor": "node scripts/release.mjs minor --tag",
    "release:major": "node scripts/release.mjs major --tag",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "git-cliff": "^2.13.1",
    "lefthook": "^2.1.10",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vite": "^8.2.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lefthook@2.1.10": true
  }
}
