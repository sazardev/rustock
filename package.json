{
  "name": "rustock",
  "version": "0.7.1",
  "license": "MIT",
  "author": "Omar Sazar <cerberusprogrammer@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/sazardev/rustock.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "design": "node scripts/design-guard.mjs",
    "routes": "node scripts/route-guard.mjs",
    "i18n": "node scripts/i18n-guard.mjs",
    "audit": "node scripts/audit.mjs",
    "verificar:etiquetas": "node scripts/verificar-code128.mjs && node scripts/verificar-etiquetas.mjs && node scripts/verificar-pdf-etiquetas.mjs",
    "verificar:escaner": "node scripts/verificar-escaner.mjs",
    "capturar": "node scripts/capturar.mjs",
    "audit:json": "node scripts/audit.mjs --json",
    "verify": "npm run typecheck && npm run lint && npm run design && npm run routes && npm run i18n && node scripts/audit.mjs && npm run build",
    "verify:full": "npm run verify && cargo fmt --all -- --check --manifest-path src-tauri/Cargo.toml && cargo clippy --all-targets --all-features --manifest-path src-tauri/Cargo.toml -- -D warnings && cargo check --all-targets --manifest-path src-tauri/Cargo.toml",
    "hooks": "lefthook install",
    "changelog": "git-cliff --output CHANGELOG.md",
    "changelog:unreleased": "git-cliff --output CHANGELOG.md --unreleased",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch --tag",
    "release:minor": "node scripts/release.mjs minor --tag",
    "release:major": "node scripts/release.mjs major --tag",
    "tauri": "tauri",
    "tauri:web": "node scripts/web.mjs",
    "dev:web": "bash scripts/dev.sh"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router": "^8.3.0",
    "three": "^0.185.1",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "git-cliff": "^2.13.1",
    "lefthook": "^2.1.10",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vite": "^8.2.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lefthook@2.1.10": true
  }
}
