{
  "name": "Rustock — WMS self-hosted para control total de tu almacén",
  "short_name": "Rustock",
  "description": "WMS self-hosted todo en uno: stock en tiempo real, lotes con FIFO/FEFO, trazabilidad inmutable y sin nube. Tus datos, tu servidor.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#FBFAF8",
  "theme_color": "#B7410E",
  "categories": ["business", "productivity", "utilities"],
  "handle_links": "preferred",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "edge_side_panel": { "preferred_width": 400 },
  "icons": [
    {
      "src": "/rustock-16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/rustock-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/rustock-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/rustock-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/rustock-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/og-image.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Rustock — dashboard del almacén"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Ver el estado del almacén",
      "url": "/dashboard",
      "icons": [{ "src": "/rustock-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Movimientos",
      "short_name": "Movimientos",
      "description": "Registrar entradas, salidas y traslados",
      "url": "/movimientos",
      "icons": [{ "src": "/rustock-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Ayuda",
      "short_name": "Ayuda",
      "description": "26 guías y glosario de 46 términos",
      "url": "/ayuda",
      "icons": [{ "src": "/rustock-192.png", "sizes": "192x192" }]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false
